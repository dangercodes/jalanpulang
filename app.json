{
  "expo": {
    "name": "JalanPulang",
    "slug": "jalanpulang-app",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-jalanpulang.png",
    "scheme": "jalanpulang",
    "splash": {
      "image": "./assets/images/logo-jalanpulang-with-text-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-jalanpulang.png",
        "backgroundImage": "./assets/images/logo-jalanpulang.png",
        "monochromeImage": "./assets/images/logo-jalanpulang-monochrome.png"
      },
      "splash": {
        "image": "./assets/images/logo-jalanpulang-with-text-white.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.reksi.jalanpulang"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-jalanpulang.png",
          "color": "#926247",
          "sounds": ["./assets/sounds/adhan.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-jalanpulang-with-text-white.png",
          "resizeMode": "cover",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65e11421-9611-4e4f-9ba3-b7ebd0abbc03"
      }
    }
  }
}
